# Copy this file to ".env" (same folder) and fill in your own key.
# ".env" is gitignored -- it will never be committed or pushed.
#
# Leave GEMINI_API_KEY blank (or delete this file) to use the offline
# Tesseract OCR engine instead -- no internet, no API key needed.
#
# NOTE: Tesseract is built for PRINTED text. On a handwritten register it
# flattens the table into plain text and the columns stop lining up, which
# is why House/Name/Class end up in the wrong boxes. If your registers are
# handwritten, you want the Gemini path below.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model reads the register photo FIRST. Keep this a low-end "lite"
# model: they are the ones a free key can actually use all day.
# Do NOT put gemini-4-argon here on a free key -- its free-tier limit is 0,
# so every scan is rejected (HTTP 429) and it looks like the key is broken.
GEMINI_MODEL=gemini-3.5-flash-lite

# If that model is out of quota, busy or retired, the app automatically tries
# these next, in order, and only then falls back to Tesseract:
#   gemini-3.5-flash-lite -> gemini-3.1-flash-lite -> gemini-flash-lite-latest
#   -> gemma-4-26b-a4b-it -> Tesseract (offline)
# To choose your own order, list the models here (this replaces the list above):
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# How hard the model thinks before answering: low / medium / high.
# "low" uses the fewest tokens, so the free quota lasts longest.
GEMINI_THINKING=low

# Seconds to wait on one model before trying the next, and on all of them
# together before giving up and using Tesseract.
GEMINI_TIMEOUT=45
GEMINI_TOTAL_TIMEOUT=90
