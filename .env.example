# Copy this file to ".env" (same folder) and fill in your own key.
# ".env" is gitignored -- it will never be committed or pushed.
#
# Leave GEMINI_API_KEY blank (or delete this file) to use the offline
# Tesseract OCR engine instead -- no internet, no API key needed.
#
# NOTE: Tesseract is built for PRINTED text. On a handwritten register it
# flattens the table into plain text and the columns stop lining up, which
# is why House/Name/Class end up in the wrong boxes. If your registers are
# handwritten, you want the Gemini path below.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model reads the register photo.
#   gemini-4-argon        best at keeping table columns aligned (default)
#   gemini-3.8-flash      faster and cheaper, still good
#   gemini-3.5-flash-lite cheapest, weakest on handwriting
GEMINI_MODEL=gemini-4-argon

# How hard the model thinks before answering: high / medium / low.
# "high" is what keeps each row's House, Name and Class in their own
# columns. Drop to "low" only if your registers are printed or very neat.
GEMINI_THINKING=high

# Seconds to wait for Gemini before falling back to Tesseract.
GEMINI_TIMEOUT=120
